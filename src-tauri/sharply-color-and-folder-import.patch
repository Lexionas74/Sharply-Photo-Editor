+/// Approximate correlated colour temperature (Kelvin) for the illuminants
+/// rawler's camera database uses when it stores a camera's calibration
+/// matrices (mirrors the constants the DNG spec assigns to these same
+/// standard illuminant identifiers).
+fn illuminant_kelvin(illuminant: Illuminant) -> f32 {
+  match illuminant {
+    Illuminant::Tungsten | Illuminant::A | Illuminant::IsoStudioTungsten => 2850.0,
+    Illuminant::CoolWhiteFluorescent | Illuminant::WhiteFluorescent | Illuminant::Fluorescent => 4000.0,
+    Illuminant::DaylightFluorescent | Illuminant::DaylightWhiteFluorescent => 5000.0,
+    Illuminant::B => 4874.0,
+    Illuminant::D50 => 5003.0,
+    Illuminant::D55 | Illuminant::Flash => 5503.0,
+    Illuminant::C => 6774.0,
+    Illuminant::D65 | Illuminant::Daylight | Illuminant::FineWeather => 6504.0,
+    Illuminant::D75 | Illuminant::CloudyWeather | Illuminant::Shade => 7504.0,
+    Illuminant::Unknown => 6504.0,
+  }
+}
+
+/// McCamy's closed-form approximation of correlated colour temperature from
+/// CIE XYZ. Accurate to a few Kelvin across the 2000-10000K range typical of
+/// camera white balance, without needing an iterative Planckian-locus search.
+fn cct_from_xyz(xyz: [f32; 3]) -> f32 {
+  let sum = xyz[0] + xyz[1] + xyz[2];
+  if !(sum > 1e-6) {
+    return 6504.0;
+  }
+  let x = xyz[0] / sum;
+  let y = xyz[1] / sum;
+  let denominator = 0.1858 - y;
+  if denominator.abs() < 1e-6 {
+    return 6504.0;
+  }
+  let n = (x - 0.3320) / denominator;
+  (437.0 * n.powi(3) + 3601.0 * n.powi(2) + 6861.0 * n + 5517.0).clamp(2000.0, 25000.0)
+}
+
+/// Blends two calibration matrices the way DNG/Adobe raw converters do:
+/// linearly in "mired" (reciprocal megakelvin) space, weighted by how close
+/// the scene's estimated colour temperature is to each calibration
+/// illuminant. This is what lets one camera's *pair* of matrices track
+/// colour correctly across different lighting, instead of a single fixed
+/// matrix that is only truly correct under one illuminant.
+fn blend_matrices(low: [[f32; 3]; 3], low_k: f32, high: [[f32; 3]; 3], high_k: f32, cct: f32) -> [[f32; 3]; 3] {
+  if (high_k - low_k).abs() < 1.0 {
+    return low;
+  }
+  let mired_low = 1_000_000.0 / low_k;
+  let mired_high = 1_000_000.0 / high_k;
+  let mired_scene = 1_000_000.0 / cct.clamp(low_k.min(high_k), low_k.max(high_k));
+  let weight_low = ((mired_scene - mired_high) / (mired_low - mired_high)).clamp(0.0, 1.0);
+  let mut out = [[0.0_f32; 3]; 3];
+  for row in 0..3 {
+    for col in 0..3 {
+      out[row][col] = weight_low * low[row][col] + (1.0 - weight_low) * high[row][col];
+    }
+  }
+  out
+}
+
+/// Selects (and, where the camera provides more than one calibration
+/// illuminant, blends) the camera's *own* colour matrices — the real
+/// per-camera-model calibration data rawler ships for hundreds of bodies —
+/// instead of a single generic transform. This is what actually makes the
+/// colour render "per camera": each model has its own matrix pair, and the
+/// blend below is solved for this shot's own as-shot white balance rather
+/// than assuming one fixed illuminant. Returns the resulting camera->XYZ(D50)
+/// matrix together with the estimated scene colour temperature, or `None`
+/// when this camera model has no calibration data in the database at all.
+fn camera_to_xyz_matrix(raw: &RawImage, white_balance: [f32; 4]) -> Option<([[f32; 3]; 3], f32)> {
+  let mut matrices: Vec<(Illuminant, [[f32; 3]; 3])> = raw
+    .color_matrix
+    .iter()
+    .filter_map(|(illuminant, flat)| transform_1d::<3, 3>(flat).map(|matrix| (*illuminant, matrix)))
+    .collect();
+  if matrices.is_empty() {
+    return None;
+  }
+  matrices.sort_by(|a, b| illuminant_kelvin(a.0).partial_cmp(&illuminant_kelvin(b.0)).unwrap_or(std::cmp::Ordering::Equal));
+  let (low_illuminant, low_matrix) = matrices[0];
+  let (high_illuminant, high_matrix) = *matrices.last().expect("checked non-empty above");
+
+  if matrices.len() == 1 || low_illuminant == high_illuminant {
+    let kelvin = illuminant_kelvin(low_illuminant);
+    return Some((pseudo_inverse::<3>(low_matrix), kelvin));
+  }
+
+  let low_k = illuminant_kelvin(low_illuminant);
+  let high_k = illuminant_kelvin(high_illuminant);
+  // A neutral (grey) subject's raw camera-space colour is the reciprocal of
+  // the as-shot white balance multipliers a neutral patch needs to look
+  // neutral. Running that through a candidate cam->XYZ matrix and estimating
+  // its colour temperature lets this pick the correct blend for *this*
+  // shot's actual lighting rather than a single "generic daylight" matrix.
+  let cam_neutral = [
+    if white_balance[0] > 0.0 { 1.0 / white_balance[0] } else { 1.0 },
+    1.0,
+    if white_balance[2] > 0.0 { 1.0 / white_balance[2] } else { 1.0 },
+  ];
+  let mut cct = (low_k + high_k) / 2.0;
+  let mut matrix = blend_matrices(low_matrix, low_k, high_matrix, high_k, cct);
+  // A few fixed-point iterations converge quickly: re-estimate CCT from the
+  // neutral point run through the current blend, then re-blend against that
+  // estimate (the same approach DNG-based converters use).
+  for _ in 0..3 {
+    let cam_to_xyz = pseudo_inverse::<3>(matrix);
+    let xyz = multiply_row1(&cam_to_xyz, &cam_neutral);
+    cct = cct_from_xyz(xyz);
+    matrix = blend_matrices(low_matrix, low_k, high_matrix, high_k, cct);
+  }
+  Some((pseudo_inverse::<3>(matrix), cct))
+}
