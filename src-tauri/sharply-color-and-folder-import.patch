From 8105fd81f1eb879883ce408a31f1bec7603a1ec4 Mon Sep 17 00:00:00 2001
From: Sharply Contributor <sharply-dev@example.com>
Date: Tue, 8 Sep 2026 07:32:45 +0000
Subject: [PATCH 2/2] Allow dragging photos or whole folders in to import

The library dropzone only ever read DataTransfer.files, which for a
dropped folder is empty/unreadable - only loose files worked.

Adds a recursive walk over the drop's FileSystemEntry list (via
webkitGetAsEntry/readEntries) so a dropped folder, including nested
subfolders, is expanded into its files before handing off to the
existing import pipeline. Falls back to the plain file list on
webviews without the entry API.

Also adds a non-drag 'Import folder' button (webkitdirectory file
input) as an equivalent folder-import path, and widens the RAW
extension allow-list/file picker to match the manufacturers the
backend now has color profiles for.
---
 src/App.tsx    | 103 +++++++++++++++++++++++++++++++++++++++++++++----
 src/styles.css |   2 +-
 2 files changed, 97 insertions(+), 8 deletions(-)

diff --git a/src/App.tsx b/src/App.tsx
index f4435e0..918d209 100644
--- a/src/App.tsx
+++ b/src/App.tsx
@@ -41,9 +41,81 @@ type Photo = {
   profile?: string
 }
 
-type CameraProfileKey = 'auto' | 'canon' | 'nikon' | 'sony'
+type CameraProfileKey = 'auto' | 'canon' | 'nikon' | 'sony' | 'fuji' | 'olympus' | 'panasonic' | 'pentax' | 'leica'
 type RawDecodeResponse = { png: string; camera_make: string; camera_model: string; profile: string }
 
+// Raw extensions for every manufacturer the backend now has a colour profile
+// for (see `camera_profile` in src-tauri/src/lib.rs), plus DNG which several
+// makers (Adobe, Leica, Pentax, Apple ProRAW) use directly.
+const RAW_EXTENSIONS = [
+  'cr1', 'cr2', 'cr3', 'crw', // Canon
+  'nef', 'nrw', // Nikon
+  'arw', 'srf', 'sr2', // Sony
+  'raf', // Fujifilm
+  'orf', // Olympus / OM System
+  'rw2', // Panasonic
+  'pef', 'ptx', // Pentax
+  '3fr', // Hasselblad
+  'iiq', // Phase One
+  'mos', // Leaf
+  'mef', // Mamiya
+  'srw', // Samsung
+  'dng', // Adobe / Leica / Pentax / Apple ProRAW
+]
+const RAW_ACCEPT = RAW_EXTENSIONS.map((extension) => `.${extension}`).join(',')
+
+// Recursively walks a dropped `FileSystemEntry` (a single file, or a folder
+// that may itself contain nested folders) and resolves every file within it.
+// The browser-native `DataTransfer.files` list only ever contains the
+// top-level dropped items and, for a folder, an unreadable placeholder — this
+// is what actually makes dragging a folder onto the app work.
+function readEntry(entry: FileSystemEntry): Promise<File[]> {
+  return new Promise((resolve) => {
+    if (entry.isFile) {
+      (entry as FileSystemFileEntry).file((file) => resolve([file]), () => resolve([]))
+      return
+    }
+    if (!entry.isDirectory) {
+      resolve([])
+      return
+    }
+    const reader = (entry as FileSystemDirectoryEntry).createReader()
+    const children: FileSystemEntry[] = []
+    // `readEntries` only returns a batch at a time (commonly capped around
+    // 100 entries per call), so it has to be called repeatedly until it
+    // reports an empty batch before a folder's contents are fully known.
+    const readNextBatch = () => {
+      reader.readEntries(async (batch) => {
+        if (batch.length === 0) {
+          const nested = await Promise.all(children.map(readEntry))
+          resolve(nested.flat())
+          return
+        }
+        children.push(...batch)
+        readNextBatch()
+      }, () => resolve([]))
+    }
+    readNextBatch()
+  })
+}
+
+// Expands whatever was dropped — a mix of loose files and/or folders — into
+// a flat file list, falling back to the plain file list on browsers/webviews
+// that don't expose the entry API.
+async function filesFromDataTransfer(dataTransfer: DataTransfer): Promise<File[]> {
+  const items = dataTransfer.items
+  if (items && items.length > 0) {
+    const entries = Array.from(items)
+      .map((item) => item.webkitGetAsEntry?.())
+      .filter((entry): entry is FileSystemEntry => Boolean(entry))
+    if (entries.length > 0) {
+      const nested = await Promise.all(entries.map(readEntry))
+      return nested.flat()
+    }
+  }
+  return Array.from(dataTransfer.files)
+}
